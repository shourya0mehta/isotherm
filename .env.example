# Copy to .env (same folder as config/) and fill in. Never commit .env or your key file.
# Kalshi API key id (shown when you create the key in Account > Profile > API Keys)
KALSHI_KEY_ID=
# Path to the private key file Kalshi downloaded for you (Ed25519 recommended)
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/kalshi_key.pem
# Optional: override API base (defaults to https://external-api.kalshi.com/trade-api/v2)
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
# Where NBM bulletins are cached
WXBOT_CACHE=~/.cache/wxbot/nbm

# which config the bot runs (config/example.yaml is a paper-trading example)
WXBOT_CONFIG=config/example.yaml
